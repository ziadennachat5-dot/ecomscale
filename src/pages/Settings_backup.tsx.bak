import { FormEvent, useState, useEffect, useRef } from "react";
import { CheckCircle2, ExternalLink, User, Building2, Lock, Save, X, Loader2, Store, Truck, RefreshCw, Bell, Search as SearchIcon, Clock, Zap, Package, ArrowRight } from "lucide-react";
import { useNavigate } from "react-router-dom";
import { PageHeader } from "../components/PageHeader";
import { useIntegrations } from "../hooks/useIntegrations";
import { useTheme } from "../hooks/useTheme";
import { googleAuthorizeUrl, youcanAuthorizeUrl } from "../lib/oauth";
import { useAuth } from "../hooks/useAuth";
import { supabase } from "../lib/supabase";
import { resetWorkspaceData } from "../lib/admin";
import { toast } from "../components/Toast";
import { WorkspaceResetModal, WorkspaceResetProgressModal, WorkspaceResetSuccessModal } from "../components/WorkspaceResetModal";
import OzonShippingIntegrationCard from "./settings/components/OzonShippingIntegrationCard";
import ColiatyShippingIntegrationCard from "./settings/components/ColiatyShippingIntegrationCard";
import GoogleSheetIntegrationCard from "./settings/components/GoogleSheetIntegrationCard";
import MetaIntegrationCard from "./settings/components/MetaIntegrationCard";
import YouCanIntegrationCard from "./settings/components/YouCanIntegrationCard";
import ShopifyIntegrationCard from "./settings/components/ShopifyIntegrationCard";

// Imports for integration logos
import imgGoogleSheets from "../assets/integrationicon/imgi_33_google sheet.png";
import imgYouCan from "../assets/integrationicon/imgi_32_youcan.png";
import imgDigylog from "../assets/integrationicon/imgi_31_digylog.jpg";
import imgLivo from "../assets/integrationicon/imgi_30_livo.png";
import imgForcelog from "../assets/integrationicon/imgi_29_forcelog.jpg";
import imgAmeex from "../assets/integrationicon/imgi_28_ameex.jpg";
import imgOzonExpress from "../assets/integrationicon/imgi_27_ozonexpress.jpg";
import { Search as SearchIcon } from "lucide-react";

const TABS = ["Profile", "Workspace", "Integrations", "Notifications"] as const;
const ACCENT_PRESETS = ["#DB6A8F", "#00B57F", "#3B82F6", "#F59E0B", "#8B5CF6"];
const WORKSPACE_ACCENT_PREFIX = "ecom-scale-accent:";

function isValidHex(value: string) {
  return /^#([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$/.test(value);
}

type Tab = (typeof TABS)[number];

export default function Settings() {
  const [tab, setTab] = useState<Tab>("Profile");
  const navigate = useNavigate();

  return (
    <div>
      <PageHeader title="Settings" subtitle="Manage your profile, workspace, and integrations." />

      <div className="mb-5 flex flex-wrap gap-2">
        <div className="inline-flex rounded-lg border border-base-border bg-base-surface p-1">
          {TABS.map((t) => (
            <button
              key={t}
              onClick={() => setTab(t)}
              className={`rounded-md px-3 py-1.5 text-[12.5px] font-medium transition-colors ${tab === t ? "bg-base-raised text-ink" : "text-ink-muted hover:text-ink"
                }`}
            >
              {t}
            </button>
          ))}
        </div>
      </div>

      {tab === "Profile" && <ProfileTab />}
      {tab === "Workspace" && <WorkspaceTab />}
      {tab === "Integrations" && <IntegrationsTab />}
      {tab === "Notifications" && (
        <ComingNext title="Notifications" subtitle="SMS and email alerts for new orders. Coming next." />
      )}
    </div>
  );
}

// ─── Profile Tab ──────────────────────────────────────────────────────────────

function ProfileTab() {
  const { profile, refreshProfile, session } = useAuth();
  const [fullName, setFullName] = useState(profile?.full_name ?? "");
  const [busy, setBusy] = useState(false);
  const [saved, setSaved] = useState(false);
  const [error, setError] = useState<string | null>(null);

  // Password change
  const [newPassword, setNewPassword] = useState("");
  const [pwBusy, setPwBusy] = useState(false);
  const [pwMsg, setPwMsg] = useState<string | null>(null);

  const handleSaveProfile = async (e: FormEvent) => {
    e.preventDefault();
    if (!profile) return;
    setBusy(true);
    setError(null);
    const { error } = await supabase
      .from("profiles")
      .update({ full_name: fullName.trim() })
      .eq("id", session!.user.id);
    setBusy(false);
    if (error) {
      setError(error.message);
    } else {
      setSaved(true);
      refreshProfile();
      setTimeout(() => setSaved(false), 2500);
    }
  };

  const handleChangePassword = async (e: FormEvent) => {
    e.preventDefault();
    setPwBusy(true);
    setPwMsg(null);
    const { error } = await supabase.auth.updateUser({ password: newPassword });
    setPwBusy(false);
    if (error) {
      setPwMsg("Error: " + error.message);
    } else {
      setPwMsg("Password updated successfully.");
      setNewPassword("");
    }
  };

  return (
    <div className="flex flex-col gap-4 max-w-lg">
      {/* Profile Info */}
      <div className="rounded-xl border border-base-border bg-base-surface p-5 shadow-card">
        <div className="flex items-center gap-2 mb-4">
          <div className="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-accent/15 text-brand-accent">
            <User size={15} />
          </div>
          <div className="text-[14px] font-semibold text-ink">Profile Information</div>
        </div>

        <form onSubmit={handleSaveProfile} className="flex flex-col gap-3">
          <div>
            <label className="mb-1 block text-[12px] text-ink-muted">Full Name</label>
            <input
              type="text"
              value={fullName}
              onChange={(e) => setFullName(e.target.value)}
              className="w-full rounded-lg border border-base-border bg-base-raised px-3 py-2 text-[13px] text-ink focus:border-brand-accent/50 focus:outline-none"
            />
          </div>
          <div>
            <label className="mb-1 block text-[12px] text-ink-muted">Email</label>
            <input
              type="email"
              value={session?.user?.email ?? ""}
              disabled
              className="w-full rounded-lg border border-base-border bg-base-raised px-3 py-2 text-[13px] text-ink-muted cursor-not-allowed opacity-60"
            />
          </div>
          {error && (
            <div className="rounded-lg bg-danger/10 px-3 py-2 text-[12.5px] text-danger">{error}</div>
          )}
          <button
            type="submit"
            disabled={busy}
            className="flex items-center gap-1.5 self-start rounded-lg bg-brand-accent px-3 py-1.5 text-[12.5px] font-medium text-white hover:bg-brand-accentHover disabled:opacity-60"
          >
            <Save size={13} />
            {saved ? "Saved ✓" : busy ? "Saving…" : "Save Profile"}
          </button>
        </form>
      </div>

      {/* Change Password */}
      <div className="rounded-xl border border-base-border bg-base-surface p-5 shadow-card">
        <div className="flex items-center gap-2 mb-4">
          <div className="flex h-8 w-8 items-center justify-center rounded-lg bg-base-raised text-ink-muted">
            <Lock size={15} />
          </div>
          <div className="text-[14px] font-semibold text-ink">Change Password</div>
        </div>

        <form onSubmit={handleChangePassword} className="flex flex-col gap-3">
          <div>
            <label className="mb-1 block text-[12px] text-ink-muted">New Password</label>
            <input
              type="password"
              minLength={6}
              required
              value={newPassword}
              onChange={(e) => setNewPassword(e.target.value)}
              className="w-full rounded-lg border border-base-border bg-base-raised px-3 py-2 text-[13px] text-ink focus:border-brand-accent/50 focus:outline-none"
              placeholder="Min 6 characters"
            />
          </div>
          {pwMsg && (
            <div
              className={`rounded-lg px-3 py-2 text-[12.5px] ${pwMsg.startsWith("Error") ? "bg-danger/10 text-danger" : "bg-brand-accent/10 text-brand-accent"
                }`}
            >
              {pwMsg}
            </div>
          )}
          <button
            type="submit"
            disabled={pwBusy}
            className="flex items-center gap-1.5 self-start rounded-lg bg-base-raised border border-base-border px-3 py-1.5 text-[12.5px] font-medium text-ink hover:bg-base-surface disabled:opacity-60"
          >
            <Lock size={13} />
            {pwBusy ? "Updating…" : "Update Password"}
          </button>
        </form>
      </div>
    </div>
  );
}

// ─── Workspace Tab ────────────────────────────────────────────────────────────

function WorkspaceTab() {
  const { workspace, refreshProfile, profile } = useAuth();
  const navigate = useNavigate();
  const [name, setName] = useState(workspace?.name ?? "");
  const [shippingEnabled, setShippingEnabled] = useState<boolean>(workspace?.shipping_enabled ?? true);
  const [showShippingColumn, setShowShippingColumn] = useState<boolean>(workspace?.show_shipping_column ?? false);
  const [carrier, setCarrier] = useState<"ozon" | "coliaty">((workspace?.carrier as "ozon" | "coliaty") ?? "ozon");
  const [statusLanguage, setStatusLanguage] = useState<"en" | "fr">((workspace?.status_language as "en" | "fr") ?? "en");
  const [busy, setBusy] = useState(false);
  const [saved, setSaved] = useState(false);
  const [error, setError] = useState<string | null>(null);

  // Workspace reset state
  const [showResetModal, setShowResetModal] = useState(false);
  const [showResetProgress, setShowResetProgress] = useState(false);
  const [showResetSuccess, setShowResetSuccess] = useState(false);
  const [resetProgress, setResetProgress] = useState(0);
  const [resetStep, setResetStep] = useState("");

  useEffect(() => {
    setName(workspace?.name ?? "");
    setShippingEnabled(workspace?.shipping_enabled ?? true);
    setShowShippingColumn(workspace?.show_shipping_column ?? false);
    setCarrier((workspace?.carrier as "ozon" | "coliaty") ?? "ozon");
    setStatusLanguage((workspace?.status_language as "en" | "fr") ?? "en");
  }, [workspace?.id, workspace?.name, workspace?.carrier, workspace?.status_language]);

  const { accent, setAccent } = useTheme();
  const workspaceAccentKey = workspace?.id ? `${WORKSPACE_ACCENT_PREFIX}${workspace.id}` : ACCENT_PRESETS[0];
  const [selectedAccent, setSelectedAccent] = useState(() => {
    if (workspace?.id && typeof window !== "undefined") {
      const stored = localStorage.getItem(workspaceAccentKey);
      if (stored && isValidHex(stored)) return stored;
    }
    return accent;
  });

  useEffect(() => {
    if (!workspace?.id) {
      setSelectedAccent(accent);
      return;
    }

    if (typeof window === "undefined") return;

    const storedAccent = localStorage.getItem(workspaceAccentKey);
    if (storedAccent && isValidHex(storedAccent)) {
      setSelectedAccent(storedAccent);
      if (storedAccent !== accent) {
        setAccent(storedAccent);
      }
      return;
    }

    setSelectedAccent(accent);
  }, [workspace?.id, accent, setAccent, workspaceAccentKey]);

  const handleAccentChange = (value: string) => {
    setSelectedAccent(value);
    setAccent(value);
    if (workspace?.id) {
      localStorage.setItem(`${WORKSPACE_ACCENT_PREFIX}${workspace.id}`, value);
    }
  };

  const handleWorkspaceReset = async () => {
    if (!workspace || !profile) return;

    setShowResetModal(false);
    setShowResetProgress(true);
    setResetProgress(0);

    const steps = [
      { progress: 0, step: "Initializing..." },
      { progress: 10, step: "Validating permissions..." },
      { progress: 20, step: "Removing orders..." },
      { progress: 30, step: "Removing customers..." },
      { progress: 40, step: "Removing products..." },
      { progress: 50, step: "Removing shipping data..." },
      { progress: 60, step: "Removing integrations..." },
      { progress: 70, step: "Removing Google Sheet configuration..." },
      { progress: 80, step: "Removing workspace settings..." },
      { progress: 90, step: "Final cleanup..." },
      { progress: 100, step: "Workspace reset complete." },
    ];

    let stepIndex = 0;

    const updateProgress = () => {
      if (stepIndex < steps.length) {
        const { progress, step } = steps[stepIndex];
        setResetProgress(progress);
        setResetStep(step);
        stepIndex++;
        setTimeout(updateProgress, progress === 0 ? 500 : 800);
      }
    };

    try {
      updateProgress();

      // Execute the workspace reset
      await resetWorkspaceData(workspace.id, profile.id);

      // Invalidate auth data and refresh
      await refreshProfile();

      // Show success modal
      setShowResetProgress(false);
      setShowResetSuccess(true);

      toast.success("Workspace reset successfully");
    } catch (err: any) {
      console.error("Workspace reset failed:", err);
      setShowResetProgress(false);
      toast.error(err?.message || "Failed to reset workspace");

      // Rollback by refreshing profile
      await refreshProfile();
    }
  };

  const handleNavigateToOrders = () => {
    setShowResetSuccess(false);
    navigate("/orders");
  };

  const handleSave = async (e: FormEvent) => {
    e.preventDefault();
    if (!workspace) return;
    setBusy(true);
    setError(null);

    const trimmedName = name.trim();

    const { error } = await supabase
      .from("workspaces")
      .update({ name: trimmedName, shipping_enabled: shippingEnabled, show_shipping_column: showShippingColumn, carrier, status_language: statusLanguage })
      .eq("id", workspace.id);

    setBusy(false);
    if (error) {
      setError(error.message);
    } else {
      setSaved(true);
      setName(trimmedName);
      await refreshProfile();
      setTimeout(() => setSaved(false), 2500);
    }
  };

  return (
    <div className="flex flex-col gap-4 max-w-lg">
      <div className="rounded-xl border border-base-border bg-base-surface p-5 shadow-card">
        <div className="flex items-center gap-2 mb-4">
          <div className="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-accent/15 text-brand-accent">
            <Building2 size={15} />
          </div>
          <div className="text-[14px] font-semibold text-ink">Workspace Settings</div>
        </div>

        <form onSubmit={handleSave} className="flex flex-col gap-3">
          <div>
            <label className="mb-1 block text-[12px] text-ink-muted">Workspace Name</label>
            <input
              type="text"
              required
              value={name}
              onChange={(e) => setName(e.target.value)}
              className="w-full rounded-lg border border-base-border bg-base-raised px-3 py-2 text-[13px] text-ink focus:border-brand-accent/50 focus:outline-none"
            />
          </div>
          <div>
            <label className="mb-1 block text-[12px] text-ink-muted">Workspace ID</label>
            <input
              type="text"
              value={workspace?.id ?? ""}
              disabled
              className="w-full rounded-lg border border-base-border bg-base-raised px-3 py-2 text-[13px] text-ink-muted cursor-not-allowed opacity-60 font-mono text-[11px]"
            />
          </div>

          <div className="mt-4 rounded-xl border border-base-border bg-base-surface p-4">
            <div className="flex items-center gap-2 mb-3">
              <div className="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-accent/15 text-brand-accent">
                <Store size={15} />
              </div>
              <div>
                <div className="text-[14px] font-semibold text-ink">Customize Your UX</div>
                <div className="text-[12px] text-ink-muted">Pick a brand accent color and refresh the platform styling instantly.</div>
              </div>
            </div>

            <div className="flex flex-wrap gap-2">
              {ACCENT_PRESETS.map((color) => (
                <button
                  key={color}
                  type="button"
                  onClick={() => handleAccentChange(color)}
                  className={`h-10 w-10 rounded-xl border ${selectedAccent === color ? "border-brand-accent shadow-sm" : "border-base-border"}`}
                  style={{ backgroundColor: color }}
                  aria-label={`Select accent ${color}`}
                />
              ))}
            </div>

            <div className="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center">
              <label className="flex items-center gap-3">
                <span className="text-[12px] text-ink-muted">Custom accent</span>
                <input
                  type="color"
                  value={selectedAccent}
                  onChange={(e) => handleAccentChange(e.target.value)}
                  className="h-10 w-16 rounded-lg border border-base-border bg-base-raised p-0"
                />
              </label>
              <div className="text-[12px] text-ink-muted">
                Current color: <span className="font-semibold" style={{ color: selectedAccent }}>{selectedAccent}</span>
              </div>
            </div>
          </div>

          <div className="mt-4 rounded-xl border border-base-border bg-base-surface p-4">
            <div className="flex items-center gap-2 mb-3">
              <div className="flex h-8 w-8 items-center justify-center rounded-lg bg-base-raised text-ink-muted">
                <Truck size={15} />
              </div>
              <div>
                <div className="text-[14px] font-semibold text-ink">Modules</div>
                <div className="text-[12px] text-ink-muted">Enable or disable optional modules for this workspace.</div>
              </div>
            </div>

            <div className="flex items-center justify-between">
              <div>
                <div className="text-[13px] font-medium text-ink">Shipping Module</div>
                <div className="text-[12px] text-ink-muted">Enable or disable the Shipping section for this workspace.</div>
              </div>
              <div>
                <label className="inline-flex items-center gap-3">
                  <span className="relative">
                    <input
                      type="checkbox"
                      checked={shippingEnabled}
                      onChange={(e) => setShippingEnabled(e.target.checked)}
                      disabled={!profile || !(profile.role === "owner" || profile.role === "supervisor")}
                      className="sr-only"
                    />
                    <span className={`block w-12 h-7 rounded-full transition-colors ${shippingEnabled ? 'bg-brand-accent' : 'bg-base-border'}`} />
                    <span className={`absolute left-0 top-0.5 w-6 h-6 bg-white rounded-full transform transition-transform ${shippingEnabled ? 'translate-x-5' : 'translate-x-0'}`} />
                  </span>
                </label>
              </div>
            </div>

            <div className="flex items-center justify-between mt-4">
              <div>
                <div className="text-[13px] font-medium text-ink">Show Shipping Column</div>
                <div className="text-[12px] text-ink-muted">Display the Shipping cost column in the Orders table.</div>
              </div>
              <div>
                <label className="inline-flex items-center gap-3">
                  <span className="relative">
                    <input
                      type="checkbox"
                      checked={showShippingColumn}
                      onChange={(e) => setShowShippingColumn(e.target.checked)}
                      disabled={!profile || !(profile.role === "owner" || profile.role === "supervisor")}
                      className="sr-only"
                    />
                    <span className={`block w-12 h-7 rounded-full transition-colors ${showShippingColumn ? 'bg-brand-accent' : 'bg-base-border'}`} />
                    <span className={`absolute left-0 top-0.5 w-6 h-6 bg-white rounded-full transform transition-transform ${showShippingColumn ? 'translate-x-5' : 'translate-x-0'}`} />
                  </span>
                </label>
              </div>
            </div>

            <div className="flex items-center justify-between mt-4">
              <div>
                <div className="text-[13px] font-medium text-ink">Shipping Carrier</div>
                <div className="text-[12px] text-ink-muted">Select the shipping carrier for this workspace.</div>
              </div>
              <div>
                <select
                  value={carrier}
                  onChange={(e) => setCarrier(e.target.value as "ozon" | "coliaty")}
                  disabled={!profile || !(profile.role === "owner" || profile.role === "supervisor")}
                  className="rounded-lg border border-base-border bg-base-raised px-3 py-2 text-[13px] text-ink focus:border-brand-accent/50 focus:outline-none disabled:opacity-60"
                >
                  <option value="ozon">Ozon Express</option>
                  <option value="coliaty">Coliaty</option>
                </select>
              </div>
            </div>

            <div className="flex items-center justify-between mt-4">
              <div>
                <div className="text-[13px] font-medium text-ink">Order Status Language</div>
                <div className="text-[12px] text-ink-muted">Select the language for order status labels.</div>
              </div>
              <div>
                <select
                  value={statusLanguage}
                  onChange={(e) => setStatusLanguage(e.target.value as "en" | "fr")}
                  disabled={!profile || !(profile.role === "owner" || profile.role === "supervisor")}
                  className="rounded-lg border border-base-border bg-base-raised px-3 py-2 text-[13px] text-ink focus:border-brand-accent/50 focus:outline-none disabled:opacity-60"
                >
                  <option value="en">English</option>
                  <option value="fr">Français</option>
                </select>
              </div>
            </div>
          </div>

          {error && (
            <div className="rounded-lg bg-danger/10 px-3 py-2 text-[12.5px] text-danger">{error}</div>
          )}
          <button
            type="submit"
            disabled={busy}
            className="flex items-center gap-1.5 self-start rounded-lg bg-brand-accent px-3 py-1.5 text-[12.5px] font-medium text-white hover:bg-brand-accentHover disabled:opacity-60"
          >
            <Save size={13} />
            {saved ? "Saved ✓" : busy ? "Saving…" : "Save Workspace"}
          </button>

          <div className="mt-5 border-t border-base-border pt-5">
            <div className="mb-3 text-[13px] font-medium text-ink">Reset Workspace</div>
            <div className="mb-3 text-[12px] text-ink-muted">
              This permanently deletes all workspace data and returns it to a brand-new state. This action cannot be undone.
            </div>
            <button
              type="button"
              disabled={!workspace}
              onClick={() => setShowResetModal(true)}
              className="flex items-center gap-2 rounded-lg bg-danger px-3 py-2 text-[13px] font-medium text-white hover:bg-danger/90 disabled:opacity-60"
            >
              <RefreshCw size={13} />
              Reset Workspace
            </button>
          </div>
        </form>

        {/* Reset Modals */}
        <WorkspaceResetModal
          isOpen={showResetModal}
          onClose={() => setShowResetModal(false)}
          onConfirm={handleWorkspaceReset}
          workspaceName={workspace?.name}
        />
        <WorkspaceResetProgressModal
          isOpen={showResetProgress}
          progress={resetProgress}
          currentStep={resetStep}
        />
        <WorkspaceResetSuccessModal
          isOpen={showResetSuccess}
          onClose={() => setShowResetSuccess(false)}
          onNavigateToOrders={handleNavigateToOrders}
        />
      </div>
    </div>
  );
}

// ─── Coming Next placeholder ──────────────────────────────────────────────────

function ComingNext({ title, subtitle }: { title: string; subtitle: string }) {
  return (
    <div className="rounded-xl border border-base-border bg-base-surface p-4 shadow-card">
      <div className="flex items-start gap-3">
        <div className="flex h-9 w-9 flex-none items-center justify-center rounded-lg bg-base-raised text-ink-muted">
          <Store size={16} />
        </div>
        <div>
          <div className="text-[13.5px] font-medium text-ink">{title}</div>
          <div className="mt-0.5 text-[12.5px] text-ink-muted">{subtitle}</div>
        </div>
      </div>
    </div>
  );
}

// ─── Integrations Tab ─────────────────────────────────────────────────────────

// ─── Integrations Tab (Premium Redesign) ────────────────────────────────────

function IntegrationsTab() {
  const { statuses, loading, disconnect } = useIntegrations();
  const [search, setSearch] = useState("");
  const [filter, setFilter] = useState<"All" | "E-commerce Platforms" | "Logistics & Delivery" | "Data & Ads">("All");
  const [sortBy, setSortBy] = useState<"newest" | "alphabetical" | "coming-soon" | "available">("newest");

  const google = statuses["google"];

  const integrationsList = [
    {
      id: "youcan",
      name: "YouCan",
      description: "Synchronisez vos commandes directement depuis votre boutique YouCan.",
      category: "E-commerce Platforms",
      status: "available" as const,
      logoUrl: imgYouCan,
      element: <YouCanIntegrationCard />,
    },
    {
      id: "shopify",
      name: "Shopify",
      description: "Connect your Shopify store for seamless order and inventory sync.",
      category: "E-commerce Platforms",
      status: "available" as const,
      logoUrl: null,
      element: <ShopifyIntegrationCard />,
    },
    {
      id: "ozon",
      name: "Ozon Express",
      description: "Connect Ozon Express for last-mile delivery tracking.",
      category: "Logistics & Delivery",
      status: "available" as const,
      logoUrl: imgOzonExpress,
      element: <OzonShippingIntegrationCard />,
    },
    {
      id: "coliaty",
      name: "Coliaty Shipping",
      description: "Real-time shipping tracking and delivery status updates.",
      category: "Logistics & Delivery",
      status: "available" as const,
      logoUrl: null,
      element: <ColiatyShippingIntegrationCard />,
    },
    {
      id: "meta",
      name: "Meta Ads",
      description: "Sync Facebook and Instagram ad spend and campaign data.",
      category: "Data & Ads",
      status: "available" as const,
      logoUrl: null,
      element: <MetaIntegrationCard />,
    },
    {
      id: "google",
      name: "Google Sheets",
      description: "Export reports and connect Google Ads spend analytics.",
      category: "Data & Ads",
      status: "available" as const,
      logoUrl: imgGoogleSheets,
      connected: !!google?.connected,
      connectedAt: google?.connected_at,
      onConnect: () => (window.location.href = googleAuthorizeUrl()),
      onDisconnect: () => disconnect("google"),
      docsUrl: "https://developers.google.com/identity/protocols/oauth2",
    },
    // COMING SOON
    {
      id: "digylog",
      name: "Digylog",
      description: "Connect tracking and fulfillment automation.",
      category: "Logistics & Delivery",
      status: "coming-soon" as const,
      logoUrl: imgDigylog,
    },
    {
      id: "livo",
      name: "Livo",
      description: "Last-mile delivery integration with real-time updates.",
      category: "Logistics & Delivery",
      status: "coming-soon" as const,
      logoUrl: imgLivo,
    },
    {
      id: "forcelog",
      name: "Forcelog",
      description: "Logistics and tracking updates for seamless fulfillment.",
      category: "Logistics & Delivery",
      status: "coming-soon" as const,
      logoUrl: imgForcelog,
    },
    {
      id: "ameex",
      name: "Ameex",
      description: "Shipment tracking sync and delivery notifications.",
      category: "Logistics & Delivery",
      status: "coming-soon" as const,
      logoUrl: imgAmeex,
    },
  ];

  // Apply filters
  const filtered = integrationsList.filter(
    (item) =>
      (filter === "All" || item.category === filter) &&
      (item.name.toLowerCase().includes(search.toLowerCase()) ||
       item.description.toLowerCase().includes(search.toLowerCase()))
  );

  // Apply sorting
  const sorted = [...filtered].sort((a, b) => {
    switch (sortBy) {
      case "alphabetical":
        return a.name.localeCompare(b.name);
      case "coming-soon":
        return (a.status === "coming-soon" ? 1 : 0) - (b.status === "coming-soon" ? 1 : 0);
      case "available":
        return (a.status === "available" ? 1 : 0) - (b.status === "available" ? 1 : 0);
      case "newest":
      default:
        return 0; // Keep original order
    }
  });

  return (
    <div className="flex flex-col gap-8 w-full max-w-7xl mx-auto px-4 sm:px-6">
      {/* Header */}
      <div className="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <h1 className="text-2xl font-semibold text-ink">Integrations</h1>
          <p className="mt-1 text-sm text-ink-muted">Connect your favorite tools and services to automate your workflow.</p>
        </div>
        <div className="text-sm text-ink-muted">
          Showing <span className="font-semibold text-ink">{sorted.length}</span> integration{sorted.length !== 1 ? "s" : ""}
        </div>
      </div>

      {/* Controls */}
      <div className="flex flex-col lg:flex-row lg:items-center gap-4">
        {/* Category Tabs */}
        <div className="inline-flex overflow-x-auto rounded-xl border border-base-border bg-base-surface p-1.5">
          {["All", "E-commerce Platforms", "Logistics & Delivery", "Data & Ads"].map((c) => (
            <button
              key={c}
              onClick={() => setFilter(c as any)}
              className={`whitespace-nowrap rounded-lg px-4 py-2 text-[13px] font-medium transition-all duration-200 ${filter === c 
                ? "bg-base-raised text-ink shadow-sm" 
                : "text-ink-muted hover:text-ink hover:bg-base-raised/50"
              }`}
            >
              {c}
            </button>
          ))}
        </div>

        {/* Search */}
        <div className="relative flex-1 max-w-md">
          <SearchIcon size={16} className="absolute left-4 top-1/2 -translate-y-1/2 text-ink-faint" />
          <input
            type="text"
            placeholder="Search integrations..."
            value={search}
            onChange={(e) => setSearch(e.target.value)}
            className="w-full rounded-xl border border-base-border bg-base-surface py-2.5 pl-11 pr-4 text-[14px] text-ink placeholder:text-ink-faint focus:border-brand-accent/50 focus:outline-none focus:ring-2 focus:ring-brand-accent/10 transition-all"
          />
        </div>

        {/* Sort */}
        <select
          value={sortBy}
          onChange={(e) => setSortBy(e.target.value as any)}
          className="rounded-xl border border-base-border bg-base-surface px-4 py-2.5 text-[13px] text-ink focus:border-brand-accent/50 focus:outline-none transition-all"
        >
          <option value="newest">Newest</option>
          <option value="alphabetical">Alphabetical</option>
          <option value="coming-soon">Coming Soon</option>
          <option value="available">Available</option>
        </select>
      </div>

      {/* Grid */}
      {loading && sorted.length > 0 ? (
        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
          {[1, 2, 3, 4, 5, 6, 7, 8].map((i) => (
            <IntegrationCardSkeleton key={i} />
          ))}
        </div>
      ) : sorted.length === 0 ? (
        <div className="flex flex-col items-center justify-center rounded-3xl border-2 border-dashed border-base-border bg-base-surface/30 py-24 text-center">
          <div className="flex h-20 w-20 items-center justify-center rounded-2xl bg-base-raised mb-6">
            <Store size={36} className="text-ink-faint" />
          </div>
          <div className="text-[16px] font-semibold text-ink mb-2">No integrations found</div>
          <div className="text-[14px] text-ink-muted mb-6">Try adjusting your search or category filter.</div>
          <button
            onClick={() => { setSearch(""); setFilter("All"); }}
            className="rounded-xl bg-brand-accent px-6 py-2.5 text-[14px] font-medium text-white hover:bg-brand-accentHover transition-colors"
          >
            Clear Filters
          </button>
        </div>
      ) : (
        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
          {sorted.map((item) => (
            <PremiumIntegrationCard key={item.id} {...item} loading={loading} />
          ))}
        </div>
      )}
    </div>
  );
}
  const { statuses, loading, disconnect } = useIntegrations();
  const [search, setSearch] = useState("");
  const [filter, setFilter] = useState<"All" | "E-commerce Platforms" | "Logistics & Delivery" | "Data & Ads">("All");
  const [sortBy, setSortBy] = useState<"newest" | "alphabetical" | "coming-soon" | "available">("newest");

  const google = statuses["google"];

  // 1. Existing Active Integrations wrapping logic
  // We pass children to the new IntegrationWrapperCard which standardizes the look
  // while letting the specific integration component handle its own connects/disconnects.
  // Note: For YouCan, Ozon, etc., they already render their own cards. 
  // To avoid rewriting their internal connect logic, we will hide their internal styling 
  // using CSS or just render them as-is inside our grid if they are complex. 
  // Wait, let's keep it simple: instead of modifying the children heavily (which might break logic),
  // we can use the Wrapper structure for generic ones, and for the complex ones we wrap them
  // in a standard grid cell. BUT the prompt says "Replace whatever layout exists now". 
  // We should actually pass the logo and styling down to them if we can, BUT since the prompt says 
  // "Do NOT change or break any existing functionality... keep all existing logic untouched", 
  // the safest and cleanest way is to structure the wrapper *outside*, OR update their internal UI 
  // files. Since we must preserve them, we'll keep their internals but we will inject the logos 
  // via a prop if possible, or just build a facade. 

  // Actually, the simplest way to preserve 100% of the internal logic while completely redesigning 
  // the UI is to use render props or just redesign the `IntegrationCard` component that wraps them. 
  // Wait, OzonShippingIntegrationCard renders its *own* layout (lines ~54-92).
  // If I want them all to look uniform in my new grid, I'd have to edit those 6 components.
  // The Prompt: "Update the integrations page component(s) to this new design, wiring in the logo files" 
  // I will just put them in the grid. If their internal cards look weird, I'll update them later if needed.

  const integrationsList = [
    {
      id: "youcan",
      name: "YouCan",
      category: "E-commerce Platforms",
      element: <YouCanIntegrationCard />,
    },
    {
      id: "shopify",
      name: "Shopify",
      category: "E-commerce Platforms",
      element: <ShopifyIntegrationCard />,
    },
    {
      id: "ozon",
      name: "Ozon Express",
      category: "Logistics & Delivery",
      element: <OzonShippingIntegrationCard />,
    },
    {
      id: "coliaty",
      name: "Coliaty Shipping",
      category: "Logistics & Delivery",
      element: <ColiatyShippingIntegrationCard />,
    },
    {
      id: "meta",
      name: "Meta Ads",
      category: "Data & Ads",
      element: <MetaIntegrationCard />,
    },
    {
      id: "google",
      name: "Google Sheets",
      category: "Data & Ads",
      element: (
        <IntegrationCard
          name="Google Sheets"
          description="Export reports and connect Google Ads spend."
          logoUrl={imgGoogleSheets}
          connected={!!google?.connected}
          connectedAt={google?.connected_at}
          loading={loading}
          onConnect={() => (window.location.href = googleAuthorizeUrl())}
          onDisconnect={() => disconnect("google")}
          docsUrl="https://developers.google.com/identity/protocols/oauth2"
        />
      ),
    },
    // COMING SOON
    {
      id: "digylog",
      name: "Digylog",
      category: "Logistics & Delivery",
      element: <ComingSoonIntegrationCard name="Digylog" logoUrl={imgDigylog} desc="Connect tracking and fulfillment." />,
    },
    {
      id: "livo",
      name: "Livo",
      category: "Logistics & Delivery",
      element: <ComingSoonIntegrationCard name="Livo" logoUrl={imgLivo} desc="Last-mile delivery integration." />,
    },
    {
      id: "forcelog",
      name: "Forcelog",
      category: "Logistics & Delivery",
      element: <ComingSoonIntegrationCard name="Forcelog" logoUrl={imgForcelog} desc="Logistics & tracking updates." />,
    },
    {
      id: "ameex",
      name: "Ameex",
      category: "Logistics & Delivery",
      element: <ComingSoonIntegrationCard name="Ameex" logoUrl={imgAmeex} desc="Shipment tracking sync." />,
    },
  ];

  const filtered = integrationsList.filter(
    (item) =>
      (filter === "All" || item.category === filter) &&
      item.name.toLowerCase().includes(search.toLowerCase())
  );

  return (
    <div className="flex flex-col gap-6 w-full max-w-6xl">
      {/* Top Controls */}
      <div className="flex flex-col md:flex-row md:items-center justify-between gap-4">
        {/* Category Filters */}
        <div className="inline-flex overflow-x-auto rounded-lg border border-base-border bg-base-surface p-1 hide-scrollbar">
          {["All", "E-commerce Platforms", "Logistics & Delivery", "Data & Ads"].map((c) => (
            <button
              key={c}
              onClick={() => setFilter(c as any)}
              className={`whitespace-nowrap rounded-md px-3.5 py-1.5 text-[12.5px] font-medium transition-colors ${filter === c ? "bg-base-raised text-ink shadow-sm" : "text-ink-muted hover:text-ink hover:bg-base-raised/50"
                }`}
            >
              {c}
            </button>
          ))}
        </div>

        {/* Search */}
        <div className="relative w-full md:w-64">
          <SearchIcon size={14} className="absolute left-3 top-1/2 -translate-y-1/2 text-ink-faint" />
          <input
            type="text"
            placeholder="Search integrations..."
            value={search}
            onChange={(e) => setSearch(e.target.value)}
            className="w-full rounded-lg border border-base-border bg-base-surface py-[7px] pl-9 pr-3 text-[13px] text-ink placeholder:text-ink-faint focus:border-brand-accent/50 focus:outline-none"
          />
        </div>
      </div>

      {loading && filtered.length > 0 ? (
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {[1, 2, 3, 4, 5, 6].map((i) => (
            <div key={i} className="h-32 rounded-xl border border-base-border/50 bg-base-surface/50 animate-pulse" />
          ))}
        </div>
      ) : filtered.length === 0 ? (
        <div className="flex flex-col items-center justify-center rounded-2xl border border-dashed border-base-border bg-base-surface/50 py-16 text-center">
          <Store size={32} className="text-ink-faint mb-3" />
          <div className="text-[14px] font-medium text-ink">No integrations found</div>
          <div className="mt-1 text-[12.5px] text-ink-muted">Try adjusting your search or category filter.</div>
        </div>
      ) : (
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 items-start">
          {filtered.map((item) => (
            <div key={item.id} className="w-full h-full">
              {item.element}
            </div>
          ))}
        </div>
      )}
    </div>
  );
}

// ─── Redesigned Generic Integration Card ──────────────────────────────────────

function IntegrationCard({
  name,
  description,
  connected,
  connectedAt,
  loading,
  onConnect,
  onDisconnect,
  docsUrl,
  logoUrl,
}: {
  name: string;
  description: string;
  connected: boolean;
  connectedAt?: string | null;
  loading: boolean;
  onConnect: () => void;
  onDisconnect: () => void;
  docsUrl: string;
  logoUrl?: string;
}) {
  return (
    <div className="group relative flex h-full flex-col justify-between rounded-xl border border-base-border bg-base-surface p-5 shadow-sm hover:shadow-card transition-shadow">
      <div className="flex items-start gap-4 mb-4">
        <div className="flex h-12 w-12 flex-none items-center justify-center rounded-[10px] bg-white border border-base-border/70 shadow-sm overflow-hidden p-1.5">
          {logoUrl ? (
            <img src={logoUrl} alt={name} className="h-full w-full object-contain" />
          ) : (
            <Store size={20} className="text-brand-accent/50" />
          )}
        </div>
        <div>
          <div className="flex items-center gap-2 text-[14px] font-semibold text-ink">
            {name}
          </div>
          <div className="mt-1 text-[12px] leading-relaxed text-ink-muted line-clamp-2">
            {description}
          </div>
        </div>
      </div>

      <div className="flex items-center justify-between pt-1">
        {connected ? (
          <div className="flex items-center gap-1.5 rounded-full bg-emerald-500/10 px-2.5 py-1 text-[11px] font-medium text-emerald-500">
            <CheckCircle2 size={12} /> Connected
          </div>
        ) : (
          <div className="text-[11px] font-medium text-ink-faint">
            Not connected
          </div>
        )}

        {loading ? (
          <div className="h-7 w-20 animate-pulse rounded-lg bg-base-raised" />
        ) : connected ? (
          <button
            onClick={onDisconnect}
            className="rounded-lg border border-base-border bg-base-surface px-4 py-1.5 text-[12px] font-medium text-danger hover:bg-danger/10 hover:border-danger/30 transition-colors"
          >
            Disconnect
          </button>
        ) : (
          <button
            onClick={onConnect}
            className="rounded-lg bg-brand-accent px-4 py-1.5 text-[12px] font-medium text-white hover:bg-brand-accentHover transition-colors shadow-sm"
          >
            Connect
          </button>
        )}
      </div>
    </div>
  );
}

// ─── Coming Soon Integration Card ─────────────────────────────────────────────

function ComingSoonIntegrationCard({ name, logoUrl, desc }: { name: string; logoUrl: string, desc: string }) {
  return (
    <div className="group relative flex h-full flex-col justify-between rounded-xl border border-base-border/50 bg-base-surface/50 p-5 shadow-sm opacity-[0.85] transition-opacity hover:opacity-100">
      <div className="flex items-start gap-4 mb-4">
        <div className="flex h-12 w-12 flex-none items-center justify-center rounded-[10px] bg-white border border-base-border/70 shadow-sm overflow-hidden p-1.5 grayscale-[0.3]">
          <img src={logoUrl} alt={name} className="h-full w-full object-contain" />
        </div>
        <div>
          <div className="flex items-center gap-2 text-[14px] font-semibold text-ink">
            {name}
          </div>
          <div className="mt-1 text-[12px] leading-relaxed text-ink-muted line-clamp-2">
            {desc}
          </div>
        </div>
      </div>

      <div className="flex items-center justify-between pt-1">
        <div className="flex items-center gap-1.5 rounded-full bg-base-raised border border-base-border px-2.5 py-1 text-[11px] font-medium text-ink-muted">
          Coming Soon
        </div>

        <button
          disabled
          className="rounded-lg border border-base-border bg-base-surface/50 px-4 py-1.5 text-[12px] font-medium text-ink-muted opacity-60 cursor-not-allowed"
        >
          Notify me
        </button>
      </div>
    </div>
  );
}

// ─── Premium Integration Card Component ─────────────────────────────────────

interface PremiumIntegrationCardProps {
  id: string;
  name: string;
  description: string;
  category: string;
  status: "available" | "coming-soon" | "beta" | "connected" | "disconnected";
  logoUrl?: string | null;
  connected?: boolean;
  connectedAt?: string | null;
  loading?: boolean;
  onConnect?: () => void;
  onDisconnect?: () => void;
  docsUrl?: string;
  element?: React.ReactNode;
}

function PremiumIntegrationCard({
  name,
  description,
  status,
  logoUrl,
  connected,
  connectedAt,
  loading,
  onConnect,
  onDisconnect,
  docsUrl,
  element,
}: PremiumIntegrationCardProps) {
  const [imgLoaded, setImgLoaded] = useState(false);
  const [imgError, setImgError] = useState(false);
  const imgRef = useRef<HTMLImageElement>(null);

  // If element is provided (for complex integrations), render it
  if (element) {
    return <div className="w-full h-full">{element}</div>;
  }

  const statusConfig = {
    "coming-soon": {
      bg: "#EEF4FF",
      text: "#3B82F6",
      label: "Coming Soon",
      icon: <Clock size={12} />,
    },
    available: {
      bg: "#ECFDF5",
      text: "#10B981",
      label: "Available",
      icon: <Zap size={12} />,
    },
    beta: {
      bg: "#FEF3C7",
      text: "#F59E0B",
      label: "Beta",
      icon: <Package size={12} />,
    },
    connected: {
      bg: "#DCFCE7",
      text: "#15803D",
      label: "Connected",
      icon: <CheckCircle2 size={12} />,
    },
    disconnected: {
      bg: "#FEE2E2",
      text: "#DC2626",
      label: "Disconnected",
      icon: <X size={12} />,
    },
  };

  const config = statusConfig[status];

  return (
    <div className="group relative flex flex-col rounded-[22px] border border-base-border bg-white p-6 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-250 h-full">
      {/* Logo */}
      <div className="flex items-start gap-4 mb-4">
        <div className="flex h-16 w-16 flex-none items-center justify-center rounded-2xl bg-white border border-base-border/60 shadow-sm overflow-hidden relative">
          {logoUrl && !imgError ? (
            <img
              ref={imgRef}
              src={logoUrl}
              alt={name}
              className="h-full w-full object-contain p-1"
              onLoad={() => setImgLoaded(true)}
              onError={() => setImgError(true)}
              style={{ opacity: imgLoaded ? 1 : 0 }}
            />
          ) : (
            <Store size={28} className="text-brand-accent/50" />
          )}
        </div>

        {/* Content */}
        <div className="flex-1 min-w-0">
          <div className="flex items-center gap-2 mb-2">
            <h3 className="text-[18px] font-semibold text-ink group-hover:text-brand-accent transition-colors">{name}</h3>
            <div className={`flex items-center gap-1.5 rounded-full px-3 py-1 text-[12px] font-semibold ${config.text} ${config.bg}`}>
              {config.icon}
              {config.label}
            </div>
          </div>
          <p className="text-[14px] text-ink-muted leading-relaxed line-clamp-2">{description}</p>
        </div>
      </div>

      {/* Actions */}
      <div className="mt-auto pt-4 border-t border-base-border/50">
        {status === "coming-soon" ? (
          <button className="w-full h-[38px] rounded-xl border border-base-border bg-base-surface text-[13px] font-medium text-ink hover:bg-base-raised hover:border-brand-accent/30 transition-all flex items-center justify-center gap-2 group-hover:opacity-100">
            <Bell size={16} />
            Notify Me
          </button>
        ) : connected ? (
          <div className="flex items-center justify-between gap-3">
            <div className="flex items-center gap-2 text-[12px] text-ink-muted">
              <CheckCircle2 size={14} className="text-emerald-500" />
              Connected
            </div>
            <button
              onClick={onDisconnect}
              className="rounded-xl border border-base-border bg-base-surface px-4 py-2 text-[13px] font-medium text-danger hover:bg-danger/10 hover:border-danger/30 transition-all"
            >
              Disconnect
            </button>
          </div>
        ) : (
          <button
            onClick={onConnect}
            disabled={loading}
            className="w-full h-[38px] rounded-xl bg-brand-accent text-[13px] font-medium text-white hover:bg-brand-accentHover transition-all flex items-center justify-center gap-2 shadow-sm hover:shadow-md disabled:opacity-60 disabled:cursor-not-allowed"
          >
            {loading ? <Loader2 size={16} className="animate-spin" /> : <ArrowRight size={16} />}
            {loading ? "Connecting..." : "Connect"}
          </button>
        )}
      </div>

      {/* Documentation Link */}
      {docsUrl && (
        <a
          href={docsUrl}
          target="_blank"
          rel="noreferrer"
          className="mt-3 inline-flex items-center gap-1.5 text-[12px] text-ink-faint hover:text-brand-accent transition-colors"
        >
          <ExternalLink size={12} />
          Documentation
        </a>
      )}
    </div>
  );
}

// ─── Integration Card Skeleton ───────────────────────────────────────────────

function IntegrationCardSkeleton() {
  return (
    <div className="flex flex-col rounded-[22px] border border-base-border/50 bg-base-surface p-6 h-full">
      <div className="flex items-start gap-4 mb-4">
        <div className="h-16 w-16 rounded-2xl bg-base-raised animate-pulse" />
        <div className="flex-1 space-y-2">
          <div className="h-5 w-3/4 rounded-lg bg-base-raised animate-pulse" />
          <div className="h-4 w-full rounded-lg bg-base-raised animate-pulse" />
        </div>
      </div>
      <div className="mt-auto pt-4 border-t border-base-border/50">
        <div className="h-[38px] w-full rounded-xl bg-base-raised animate-pulse" />
      </div>
    </div>
  );
}
